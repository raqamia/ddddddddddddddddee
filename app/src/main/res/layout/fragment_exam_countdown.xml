<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="رجوع"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="180"
            app:tint="@color/text_dark_primary" />

        <TextView
            style="@style/Text.Black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/exam_countdown"
            android:textColor="@color/text_dark_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- بطاقة العدّاد الرئيسية -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_white_50"
                    android:padding="13dp"
                    android:src="@drawable/ic_school_outline"
                    android:contentDescription="@string/cd_school_icon"
                    app:tint="@color/white" />

                <TextView
                    style="@style/Text.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/countdown_remaining"
                    android:textColor="@color/white_45"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_exam_date"
                    style="@style/Text.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exam_date"
                    android:textColor="@color/white_35"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- العدّاد (أيام، ساعات، دقائق، ثوانٍ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- أيام -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_days"
                        style="@style/Text.Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_placeholder"
                android:textColor="@color/accent_gold"
                android:textSize="42sp" />

                    <TextView
                        style="@style/Text.Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/countdown_day"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/countdown_separator"
                    android:textColor="@color/text_dark_secondary"
                    android:textSize="36sp" />

                <!-- ساعات -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hours"
                        style="@style/Text.Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_placeholder"
                        android:textColor="@color/accent_gold"
                        android:textSize="42sp" />

                    <TextView
                        style="@style/Text.Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/countdown_hour"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/countdown_separator"
                    android:textColor="@color/navy_light"
                    android:textSize="36sp" />

                <!-- دقائق -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_minutes"
                        style="@style/Text.Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_placeholder"
                        android:textColor="@color/accent_gold"
                        android:textSize="42sp" />

                    <TextView
                        style="@style/Text.Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/countdown_minute"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/countdown_separator"
                    android:textColor="@color/navy_light"
                    android:textSize="36sp" />

                <!-- ثوانٍ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_seconds"
                        style="@style/Text.Black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_placeholder"
                        android:textColor="@color/accent_gold"
                        android:textSize="42sp" />

                    <TextView
                        style="@style/Text.Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/countdown_second"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- رسالة تحفيزية -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_motivation"
                    style="@style/Text.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/countdown_motivation_default"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
