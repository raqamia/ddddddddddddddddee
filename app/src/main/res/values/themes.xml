<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Manara" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:layoutDirection">rtl</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy_light</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold_light</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">#80150E22</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="Theme.Manara.Splash" parent="Theme.Manara">
        <item name="android:windowBackground">@color/dark_purple_deep</item>
        <item name="postSplashScreenTheme">@style/Theme.Manara</item>
    </style>
</resources>
