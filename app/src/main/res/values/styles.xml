<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cairo brand font (see res/font/cairo.xml). -->
    <style name="Text.Regular" parent="">
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.SemiBold" parent="">
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Bold" parent="">
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Black" parent="">
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Size.XS" parent="">  <item name="android:textSize">10sp</item> </style>
    <style name="Text.Size.SM" parent="">  <item name="android:textSize">12sp</item> </style>
    <style name="Text.Size.Base" parent=""><item name="android:textSize">14sp</item> </style>
    <style name="Text.Size.MD" parent="">  <item name="android:textSize">16sp</item> </style>
    <style name="Text.Size.LG" parent="">  <item name="android:textSize">18sp</item> </style>
    <style name="Text.Size.XL" parent="">  <item name="android:textSize">22sp</item> </style>
    <style name="Text.Size.XXL" parent=""> <item name="android:textSize">28sp</item> </style>

    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:height">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Button.Gold" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="InputField" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">right|center_vertical</item>
    </style>
</resources>
